@inject IConfiguration _config
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChambaYa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-floating">
            <div class="container-fluid px-2">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:1.1rem;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <span>Chamba<span class="text-primary">Ya</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navPrincipal">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Explorar Ofertas</a>
                        </li>
                        @if (User.IsInRole("Postulante"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="MisPostulaciones">Mis Postulaciones</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="nav-link fw-semibold text-slate-600 d-none d-lg-block">Hola, @User.Identity.Name</span>
                            <a class="nav-link text-danger fw-semibold d-none d-lg-block" asp-controller="Auth" asp-action="Logout">Cerrar Sesión</a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a class="nav-link text-decoration-none me-3" asp-controller="Oferta" asp-action="Publicaciones">
                                    Publicaciones
                                </a>
                                <a class="nav-link text-decoration-none me-3" asp-controller="Oferta" asp-action="Revisiones">
                                    Revisiones
                                </a>
                                <a class="btn-primary-modern text-decoration-none" asp-controller="Oferta" asp-action="Crear">
                                    Publicar gratis
                                </a>
                            }
                        }
                        else
                        {
                            <a class="nav-link fw-semibold text-slate-600 d-none d-lg-block" asp-controller="Auth" asp-action="Login">Entrar</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1">
        @RenderBody()
    </main>

    <footer class="modern-footer">
        <div class="container">
            <div class="row g-5 mb-5">
                <div class="col-lg-4 pe-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;">
                            <i class="bi bi-briefcase-fill small"></i>
                        </div>
                        <h5 class="fw-bold mb-0 text-slate-900">ChambaYa</h5>
                    </div>
                    <p class="text-slate-500 small lh-lg">
                        La plataforma moderna que conecta el mejor talento con oportunidades laborales temporales. Rápido, seguro y sin intermediarios.
                    </p>
                </div>
                <div class="col-6 col-lg-2 offset-lg-1">
                    <h6>Plataforma</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index">Buscar trabajo</a></li>
                        <li><a asp-controller="Oferta" asp-action="Crear">Publicar oferta</a></li>
                        <li><a asp-controller="Home" asp-action="MisPostulaciones">Seguimiento</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Categorías</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/?cat=1">Tecnología</a></li>
                        <li><a href="/?cat=4">Diseño y Creatividad</a></li>
                        <li><a href="/?cat=2">Ventas</a></li>
                        <li><a href="/?cat=3">Soporte</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Contacto</h6>
                    <ul class="list-unstyled small">
                        <li><i class="bi bi-envelope me-2"></i>hola@chambaya.pe</li>
                        <li><i class="bi bi-geo-alt me-2"></i>Lima, Perú</li>
                        <li class="mt-3">
                            <div class="d-flex gap-2">
                                <a href="#" class="bg-slate-100 p-2 rounded-circle text-slate-600 hover-primary"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="bg-slate-100 p-2 rounded-circle text-slate-600 hover-primary"><i class="bi bi-twitter-x"></i></a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="pt-4 border-top border-slate-200 d-flex flex-column flex-md-row justify-content-between align-items-center small text-slate-400">
                <p class="mb-0">&copy; @DateTime.Now.Year ChambaYa Inc. Todos los derechos reservados.</p>
                <div class="d-flex gap-3 mt-3 mt-md-0">
                    <a href="#">Privacidad</a>
                    <a href="#">Términos</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.ChambaYaApiBase = '@_config["ApiBaseUrl"]';
        window.ChambaYaUsuarioId = @(User.Identity != null && User.Identity.IsAuthenticated ? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "null" : "null");
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
