@inject IConfiguration _config
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChambaYa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark chamba-navbar sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill me-1"></i>Chamba<span class="brand-dot">Ya</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Abrir navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navPrincipal">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Ofertas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Oferta" asp-action="Crear"><i class="bi bi-plus-circle me-1"></i>Publicar Oferta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="MisPostulaciones"><i class="bi bi-send me-1"></i>Mis Postulaciones</a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn btn-chamba btn-sm px-3" asp-controller="Oferta" asp-action="Crear">
                                <i class="bi bi-megaphone me-1"></i>Publicar gratis
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="chamba-footer mt-5">
        <div class="container py-5">
            <div class="row g-4 footer-superior p-4 mb-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-2"><i class="bi bi-briefcase-fill me-1"></i>Chamba<span class="brand-dot">Ya</span></h5>
                    <p class="small opacity-75 mb-0">La plataforma que conecta talento con oportunidades laborales temporales. Encuentra chamba rápido, postúlate en un clic.</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="fw-semibold text-uppercase small mb-3 opacity-75">Explorar</h6>
                    <ul class="list-unstyled small mb-0 d-grid gap-2">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1 small"></i>Ofertas de trabajo</a></li>
                        <li><a asp-controller="Oferta" asp-action="Crear"><i class="bi bi-chevron-right me-1 small"></i>Publicar oferta</a></li>
                        <li><a asp-controller="Home" asp-action="MisPostulaciones"><i class="bi bi-chevron-right me-1 small"></i>Mis postulaciones</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="fw-semibold text-uppercase small mb-3 opacity-75">Categorías</h6>
                    <ul class="list-unstyled small mb-0 d-grid gap-2">
                        <li><i class="bi bi-cpu me-1"></i>Tecnología</li>
                        <li><i class="bi bi-graph-up-arrow me-1"></i>Ventas</li>
                        <li><i class="bi bi-headset me-1"></i>Atención al Cliente</li>
                        <li><i class="bi bi-palette me-1"></i>Diseño</li>
                        <li><i class="bi bi-briefcase me-1"></i>Administración</li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h6 class="fw-semibold text-uppercase small mb-3 opacity-75">Contacto</h6>
                    <ul class="list-unstyled small mb-0 d-grid gap-2">
                        <li><i class="bi bi-envelope me-1"></i>hola@chambaya.pe</li>
                        <li><i class="bi bi-geo-alt me-1"></i>Lima, Perú</li>
                    </ul>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small opacity-75">
                <span>&copy; @DateTime.Now.Year - ChambaYa. Todos los derechos reservados.</span>
                <span>Desarrollo de Servicios Web I · CIBERTEC</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>window.ChambaYaApiBase = '@_config["ApiBaseUrl"]';</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
