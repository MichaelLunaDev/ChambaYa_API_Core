@{
    ViewData["Title"] = "Gestión de Publicaciones";
}

<div class="container py-5 my-3">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Publicaciones</h2>
            <p class="text-slate-500 mb-0">CRUD de todas tus ofertas (Editar, Eliminar).</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary-modern">
            <i class="bi bi-plus-lg"></i> Nueva Oferta
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3 text-slate-500">ID</th>
                        <th class="py-3 text-slate-500">Título</th>
                        <th class="py-3 text-slate-500">Fecha</th>
                        <th class="py-3 text-slate-500">Estado</th>
                        <th class="px-4 py-3 text-slate-500 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaCRUD">
                    <tr><td colspan="5" class="text-center py-5">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Editar -->
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Editar Oferta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formEditar">
                    <input type="hidden" id="editIdOferta" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Título</label>
                            <input type="text" class="form-control" id="editTitulo" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Categoría</label>
                            <select class="form-select" id="editCategoria" required></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Salario</label>
                            <input type="number" step="0.01" class="form-control" id="editSalario" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ubicación</label>
                            <input type="text" class="form-control" id="editUbicacion" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Modalidad</label>
                            <select class="form-select" id="editModalidad" required>
                                <option>Presencial</option><option>Remoto</option><option>Híbrido</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="editDescripcion" rows="3" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Requisitos</label>
                            <textarea class="form-control" id="editRequisitos" rows="3" required></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary-modern" onclick="guardarEdicion()">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let modalInst;
        document.addEventListener("DOMContentLoaded", async () => {
            modalInst = new bootstrap.Modal(document.getElementById("modalEditar"));
            cargarCategorias();
            cargarTabla();
        });

        async function cargarCategorias() {
            try {
                const res = await fetch(`${ChambaYa.apiBase}/Categorias`);
                const data = await res.json();
                if(data.success) {
                    document.getElementById("editCategoria").innerHTML = data.data.map(c => `<option value="${c.idCategoria}">${c.nombreCategoria}</option>`).join('');
                }
            } catch(e) {}
        }

        async function cargarTabla() {
            const userId = window.ChambaYaUsuarioId;
            if(!userId) return;
            const tbody = document.getElementById("tablaCRUD");
            
            try {
                const response = await fetch(`${ChambaYa.apiBase}/MisOfertasAdmin/${userId}`);
                const data = await response.json();

                if(data.success && data.data && data.data.length > 0) {
                    tbody.innerHTML = data.data.map(o => `
                        <tr>
                            <td class="px-4 py-3 fw-medium text-slate-500">#${o.idOferta}</td>
                            <td class="py-3 fw-bold text-slate-900">${o.titulo}</td>
                            <td class="py-3 text-slate-500">${new Date(o.fechaPublicacion).toLocaleDateString()}</td>
                            <td class="py-3"><span class="badge ${o.activa ? 'bg-success' : 'bg-secondary'} rounded-pill">${o.activa ? 'Activa' : 'Inactiva'}</span></td>
                            <td class="px-4 py-3 text-end">
                                <button class="btn btn-sm btn-outline-primary rounded-circle me-1" title="Editar" onclick="abrirEditar(${o.idOferta})"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger rounded-circle" title="Eliminar" onclick="eliminar(${o.idOferta})"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-center py-5">No tienes publicaciones.</td></tr>`;
                }
            } catch(e) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-5 text-danger">Error al cargar datos.</td></tr>`;
            }
        }

        async function abrirEditar(id) {
            try {
                const res = await fetch(`${ChambaYa.apiBase}/Oferta/${id}`);
                const data = await res.json();
                if(data.success) {
                    const of = data.data;
                    document.getElementById("editIdOferta").value = of.idOferta;
                    document.getElementById("editTitulo").value = of.titulo;
                    document.getElementById("editCategoria").value = of.idCategoria;
                    document.getElementById("editSalario").value = of.salario;
                    document.getElementById("editUbicacion").value = of.ubicacion;
                    document.getElementById("editModalidad").value = of.modalidad;
                    document.getElementById("editDescripcion").value = of.descripcion;
                    document.getElementById("editRequisitos").value = of.requisitos;
                    modalInst.show();
                }
            } catch(e) {
                Swal.fire('Error', 'No se pudo cargar la oferta', 'error');
            }
        }

        async function guardarEdicion() {
            if(!document.getElementById("formEditar").checkValidity()) {
                document.getElementById("formEditar").reportValidity();
                return;
            }
            
            const oferta = {
                idOferta: parseInt(document.getElementById("editIdOferta").value),
                idCategoria: parseInt(document.getElementById("editCategoria").value),
                titulo: document.getElementById("editTitulo").value,
                salario: parseFloat(document.getElementById("editSalario").value),
                ubicacion: document.getElementById("editUbicacion").value,
                modalidad: document.getElementById("editModalidad").value,
                descripcion: document.getElementById("editDescripcion").value,
                requisitos: document.getElementById("editRequisitos").value
            };

            try {
                const res = await fetch(`${ChambaYa.apiBase}/Oferta`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(oferta)
                });
                const data = await res.json();
                if(data.success) {
                    Swal.fire('Éxito', 'Oferta actualizada correctamente', 'success');
                    modalInst.hide();
                    cargarTabla();
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            } catch(e) {
                Swal.fire('Error', 'Error de red', 'error');
            }
        }

        function eliminar(id) {
            Swal.fire({
                title: '¿Eliminar oferta?',
                text: "Esta acción la ocultará de la bolsa de trabajo.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`${ChambaYa.apiBase}/Oferta/${id}`, { method: 'DELETE' });
                        const data = await res.json();
                        if(data.success) {
                            Swal.fire('Eliminado', 'La oferta ha sido eliminada.', 'success');
                            cargarTabla();
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    } catch(e) {
                        Swal.fire('Error', 'Problemas de red', 'error');
                    }
                }
            });
        }
    </script>
}
