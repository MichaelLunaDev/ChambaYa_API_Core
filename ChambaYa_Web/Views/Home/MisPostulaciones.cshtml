@{
    ViewData["Title"] = "Mis Postulaciones";
}

<div class="text-center py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto" style="max-width: 560px;">
        <div class="card-body p-5">
            <i class="bi bi-send display-1 text-primary opacity-75"></i>
            <h2 class="fw-bold mt-3 mb-2">Mis postulaciones</h2>
            <p class="text-muted mb-4">
                Aquí podrás ver el seguimiento de todas tus postulaciones: estado, oferta y fechas.
                Esta sección estará disponible próximamente.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-chamba">
                <i class="bi bi-briefcase me-1"></i>Explorar ofertas
            </a>
        </div>
    </div>
</div>
