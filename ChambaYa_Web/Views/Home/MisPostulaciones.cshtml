@{
    ViewData["Title"] = "Mis Postulaciones";
}

<div class="container py-5 my-3">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mis Postulaciones</h2>
            <p class="text-slate-500 mb-0">Revisa el estado de tus aplicaciones a empleos.</p>
        </div>
    </div>

    <div class="row" id="contenedorPostulaciones">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2 text-slate-500">Cargando tus postulaciones...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const userId = window.ChambaYaUsuarioId;
            const contenedor = document.getElementById("contenedorPostulaciones");
            
            if(!userId) {
                contenedor.innerHTML = `<div class="col-12 text-center py-5">
                    <h4 class="text-slate-900">Debes iniciar sesión</h4>
                    <a href="/Auth/Login" class="btn btn-primary-modern mt-3">Iniciar Sesión</a>
                </div>`;
                return;
            }

            try {
                const response = await fetch(`${ChambaYa.apiBase}/MisPostulaciones/${userId}`);
                const data = await response.json();

                if(data.success && data.data && data.data.length > 0) {
                    let html = "";
                    data.data.forEach(p => {
                        let bgBadge = "bg-warning text-dark";
                        let icon = "bi-hourglass-split";
                        if(p.estado === "Aprobado") { bgBadge = "bg-success text-white"; icon = "bi-check-circle"; }
                        if(p.estado === "Rechazado") { bgBadge = "bg-danger text-white"; icon = "bi-x-circle"; }

                        let msj = p.mensajeRespuesta ? `<div class="mt-3 p-3 bg-slate-50 rounded text-slate-700 border small"><i class="bi bi-chat-left-text me-2"></i><strong>Mensaje del reclutador:</strong><br/>${p.mensajeRespuesta}</div>` : "";

                        html += `<div class="col-md-6 mb-4">
                            <div class="modern-card h-100 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="fw-bold mb-1">${p.titulo}</h5>
                                        <p class="text-slate-500 small mb-2"><i class="bi bi-briefcase me-1"></i> ${p.nombreCategoria} &bull; <i class="bi bi-geo-alt me-1"></i> ${p.ubicacion}</p>
                                    </div>
                                    <span class="badge ${bgBadge} px-3 py-2 rounded-pill"><i class="bi ${icon} me-1"></i> ${p.estado}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                    <div class="fw-semibold text-success">S/ ${p.salario}</div>
                                    <div class="text-slate-400 small"><i class="bi bi-calendar-event me-1"></i> ${new Date(p.fechaPostulacion).toLocaleDateString()}</div>
                                </div>
                                ${msj}
                            </div>
                        </div>`;
                    });
                    contenedor.innerHTML = html;
                } else {
                    contenedor.innerHTML = `<div class="col-12 text-center py-5">
                        <i class="bi bi-folder2-open display-1 text-slate-300"></i>
                        <h4 class="text-slate-900 mt-3">No tienes postulaciones aún</h4>
                        <p class="text-slate-500">Explora ofertas y envía tu primera postulación.</p>
                        <a href="/" class="btn btn-outline-primary mt-2 rounded-pill px-4">Explorar chambas</a>
                    </div>`;
                }
            } catch(e) {
                console.error(e);
                contenedor.innerHTML = `<div class="col-12 text-center text-danger py-5"><i class="bi bi-exclamation-triangle"></i> Hubo un error al cargar tus postulaciones.</div>`;
            }
        });
    </script>
}
