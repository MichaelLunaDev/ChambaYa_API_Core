@{
    ViewData["Title"] = "Mis Postulaciones";
}

<div class="text-center py-5 my-5">
    <div class="mx-auto" style="max-width: 500px;">
        <div class="mb-4">
            <div class="bg-indigo-50 text-indigo-600 rounded-circle d-inline-flex align-items-center justify-content-center" style="width:80px;height:80px;font-size:2.5rem; background: var(--indigo-50); color: var(--indigo-600);">
                <i class="bi bi-inbox"></i>
            </div>
        </div>
        <h2 class="fw-bold mb-3 text-slate-900">Aún no hay nada por aquí</h2>
        <p class="text-slate-500 mb-5 lh-lg">
            El módulo de seguimiento de postulaciones está en desarrollo. Pronto podrás ver el estado de todas tus aplicaciones en un solo lugar.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-modern">
            <i class="bi bi-search me-1"></i> Explorar ofertas ahora
        </a>
    </div>
</div>
